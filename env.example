# --- Google Sheets ---
# Spreadsheet ID (из URL таблицы)
GOOGLE_SHEET_ID=

# Имя листа (вкладки), например "Plan"
GOOGLE_SHEET_TAB=Plan

# service_account | oauth_user
GOOGLE_AUTH_MODE=service_account

# Путь к JSON ключу сервис-аккаунта (не коммитить реальный файл)
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json

# (опционально) scopes через запятую
GOOGLE_SCOPES=https://www.googleapis.com/auth/spreadsheets.readonly

# Диапазон для чтения (пример). Подстроим под реальную структуру.
GOOGLE_SHEET_RANGE=A:Z

# --- Telegram (уведомления/бот) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Local XLSX source (for audit-xlsx and bot) ---
# "auto" = take first .xlsx in the project folder
LOCAL_XLSX_PATH=auto
# optional sheet name (default: first sheet)
LOCAL_XLSX_SHEET=

# --- OpenAI (optional, for GPT-5 summaries) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# --- Поведение аудита ---
# Сколько дней без обновлений считать проблемой
STALE_DAYS=3

